{
  "name": "@luuload/design-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Thư viện component React của Lưu Load",
  "scripts": {
    "storybook": "npm run tokens:sync && storybook dev -p 6006",
    "build-storybook": "npm run tokens:sync && storybook build",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "check:hardcode": "node scripts/check-hardcode.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens:sync && tsc --noEmit && vite build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
